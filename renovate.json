{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>sksat/renovate-config"],
  "labels": ["renovate"],
  "packageRules": [
    {
      "description": "Qwik packages are released together with the same version; update them in one PR so they never mismatch.",
      "groupName": "qwik",
      "matchPackageNames": [
        "@builder.io/qwik",
        "@builder.io/qwik-city",
        "eslint-plugin-qwik"
      ]
    }
  ]
}
