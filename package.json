{
  "name": "gallery-sksat-net",
  "description": "Demo App with Routing built-in (recommended)",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit && tsc -p workers/image && tsc -p workers/api",
    "deploy": "wrangler pages deploy ./dist --project-name gallery-sksat-net",
    "deploy.api": "wrangler deploy -c workers/api/wrangler.jsonc",
    "deploy.image": "wrangler deploy -c workers/image/wrangler.jsonc",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler pages dev ./dist",
    "start": "vite --open --mode ssr",
    "test": "vitest",
    "test.e2e": "playwright test --project=e2e",
    "test.vrt": "playwright test --project=vrt",
    "test.vrt.update": "playwright test --project=vrt --update-snapshots",
    "test.ui": "vitest --ui",
    "test.coverage": "vitest --coverage",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.4",
    "@builder.io/qwik-city": "^1.20.4",
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@types/eslint": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/ui": "^4.1.12",
    "aws4fetch": "1.0.20",
    "eslint": "^9.37.0",
    "eslint-plugin-qwik": "^1.20.4",
    "exifr": "7.1.3",
    "jose": "6.2.17",
    "maplibre-gl": "6.16.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.73.0",
    "undici": "^8.0.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
