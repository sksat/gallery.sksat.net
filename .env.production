VITE_S3_BASE_URL="https://sksat-gallery.s3.us-west-002.backblazeb2.com"
# Image Worker (workers/image) that serves resized photos at
# <base>/<preset>/<public_id> (camera pictures at <base>/<preset>/<file>).
VITE_IMAGE_BASE_URL="https://gallery.sksat.net/img"
# Cloudflare Web Analytics beacon token for gallery.sksat.net (public; it is
# embedded in every page). Created in the dashboard: Observability > Analytics
# > Web analytics.
VITE_CF_BEACON_TOKEN="750772ea05ca4b6aad5670458623f2cf"
# API Worker (workers/api). On Pages the route loaders use the `API` service
# binding (wrangler.jsonc) instead; this is the fallback without it.
VITE_API_BASE_URL="https://gallery.sksat.net/api"
