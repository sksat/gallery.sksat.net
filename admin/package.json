{
  "name": "gallery-admin",
  "description": "Admin panel for gallery.sksat.net",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "db.create": "wrangler d1 create gallery-admin",
    "db.migrate.local": "wrangler d1 migrations apply gallery-admin --local",
    "db.migrate.remote": "wrangler d1 migrations apply gallery-admin --remote",
    "db.seed.local": "wrangler d1 execute gallery-admin --local --file=migrations/seeds/0001_seed.sql",
    "db.seed.remote": "wrangler d1 execute gallery-admin --remote --file=migrations/seeds/0001_seed.sql",
    "import-media": "tsx scripts/import-media.ts",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "predeploy": "tsx scripts/check-deployable.ts",
    "deploy": "wrangler pages publish ./dist",
    "dev": "vite --mode ssr",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler pages dev ./dist",
    "start": "vite --open --mode ssr",
    "test": "vitest",
    "test.coverage": "vitest --coverage",
    "test.e2e": "playwright test --project=e2e",
    "test.vrt": "playwright test --project=vrt",
    "test.vrt.update": "playwright test --project=vrt --update-snapshots"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.16.1",
    "@builder.io/qwik-city": "^1.16.1",
    "@cloudflare/workers-types": "^4.20251004.0",
    "@playwright/test": "1.59.1",
    "@types/node": "^22.0.0",
    "ignore": "^5.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.2",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
