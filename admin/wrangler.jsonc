{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Pages project name. Wrangler reads it from here (and then rejects
  // --project-name) when run inside admin/, e.g. `pages secret put`.
  "name": "admin-gallery-sksat-net",
  "compatibility_date": "2025-04-01",
  // With `pages_build_output_dir` set, Cloudflare Pages treats this file as
  // the source of truth for bindings and ignores the dashboard. Top-level
  // settings are the production deployment (and local dev); `env.preview`
  // overrides them for preview deployments.
  "pages_build_output_dir": "./dist",
  "vars": {
    // Cloudflare Access JWT verification (src/lib/access.ts). Not secrets:
    // the team domain is public and AUD tags only identify Access apps.
    // Production accepts only the custom-domain app (admin.gallery.sksat.net).
    "ACCESS_TEAM_DOMAIN": "https://sksat.cloudflareaccess.com",
    "ACCESS_AUD": "e5ff448257acbe43d36fecf57eb2a1e2f133d21c13c46315b5d61b08f332d93a",
    // "1" = thumbnails through /thumb/* and the IMAGES binding below. Empty
    // = placeholder tiles; the originals are never loaded. E2E blanks it on
    // the command line (e2e/start-test-server.sh) so VRT stays deterministic.
    "THUMBNAILS": "1",
    // Uploads (src/lib/b2.ts): the browser PUTs originals straight to the
    // bucket through URLs presigned with B2_UPLOAD_KEY_ID /
    // B2_UPLOAD_APPLICATION_KEY, production secrets of a B2 key restricted
    // to this bucket with writeFiles + listFiles + deleteFiles (no
    // readFiles; list + delete are for 完全に削除 in the trash, which
    // removes every version). Without them uploading is off.
    "B2_ENDPOINT": "https://s3.us-west-002.backblazeb2.com",
    "B2_BUCKET": "sksat-gallery",
    "B2_REGION": "us-west-002",
    // D1 usage on the dashboard (src/lib/d1-usage.ts) through Cloudflare's
    // GraphQL Analytics API, with the production secret
    // CF_ANALYTICS_API_TOKEN (an account API token with only "Account
    // Analytics: Read"). Without the secret only the database size shows.
    // Identifiers, not credentials. Production only (not in env.preview).
    "CF_ACCOUNT_ID": "84a8852ca830f37f2d2e5bcfa7148d14",
    "D1_DATABASE_ID": "70d6bc59-9937-48e0-90bb-0ef8a2a53bcd",
    // Access stats (src/lib/web-analytics.ts), read with the same
    // CF_ANALYTICS_API_TOKEN: the Web Analytics site tag (not the beacon
    // token). It covers the whole sksat.net zone, so the host narrows it
    // to the public gallery.
    "WEB_ANALYTICS_SITE_TAG": "e02811320c7d4106aaa1e7ef097b03a6",
    "WEB_ANALYTICS_HOST": "gallery.sksat.net",
  },
  // The image Worker's AdminImage entrypoint (workers/image): resized
  // thumbnails of any photo, private included, for the /thumb route. It
  // also verifies the request's Access JWT, which the route passes on.
  "services": [
    {
      "binding": "IMAGES",
      "service": "gallery-image",
      "entrypoint": "AdminImage",
    },
  ],
  "d1_databases": [
    {
      // Production D1 (`pnpm db.create`). A database id is an identifier,
      // not a credential: access still requires Cloudflare account auth.
      "binding": "DB",
      "database_name": "gallery-admin",
      "database_id": "70d6bc59-9937-48e0-90bb-0ef8a2a53bcd",
      "migrations_dir": "migrations",
    },
  ],
  // The API Worker's last-good copies (workers/api/src/last-good-store.ts):
  // the admin deletes the ones a change affects (src/lib/last-good.ts).
  // The namespace (gallery-api-last-good) is created outside this repo.
  // TODO: replace the placeholder with the namespace id (also in
  // workers/api/wrangler.jsonc) before deploying: a deploy with it fails.
  // Production only (not in env.preview).
  "kv_namespaces": [
    {
      "binding": "LAST_GOOD",
      "id": "TODO_GALLERY_API_LAST_GOOD_KV_ID",
    },
  ],
  "env": {
    "preview": {
      // `vars` and `d1_databases` are not inherited by environments, so they
      // are restated here.
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://sksat.cloudflareaccess.com",
        // Preview deployments app (*.admin-gallery-sksat-net.pages.dev).
        "ACCESS_AUD": "eba20c113f589a0b3a11d2fd46268f17ead1732f1f5e01cbc6ef0da525d8ac8a",
        "THUMBNAILS": "1",
      },
      // Previews (incl. Renovate PRs) run unreviewed code, so they get no
      // database (the UI shows the missing-binding notice instead of being
      // able to read or rewrite production metadata) and no image Worker
      // binding (they could otherwise fetch any private photo by path):
      // thumbnails are placeholders there. The image Worker accepts only the
      // production Access app's tokens anyway.
      "services": [],
      "d1_databases": [],
      // Nor the last-good copies: previews could delete (or, worse, bump
      // the generation of) the production copies.
      "kv_namespaces": [],
    },
  },
}
