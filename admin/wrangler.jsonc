{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gallery-admin",
  "compatibility_date": "2025-04-01",
  "pages_build_output_dir": "./dist",
  "vars": {
    "B2_REGION": "us-west-002",
    "B2_BUCKET": "sksat-gallery",
    "B2_ENDPOINT": "https://s3.us-west-002.backblazeb2.com",
    // Cloudflare Access JWT verification (src/lib/access.ts). Not secrets:
    // the team domain is public and AUD tags only identify Access apps.
    // ACCESS_AUD = custom domain app, preview deployments app.
    "ACCESS_TEAM_DOMAIN": "https://sksat.cloudflareaccess.com",
    "ACCESS_AUD": "e5ff448257acbe43d36fecf57eb2a1e2f133d21c13c46315b5d61b08f332d93a,eba20c113f589a0b3a11d2fd46268f17ead1732f1f5e01cbc6ef0da525d8ac8a",
  },
  "d1_databases": [
    {
      // Override `database_id` locally after running `pnpm db.create`. The
      // committed value is a syntactically valid all-zero UUID so Cloudflare
      // Pages preview validation passes; production binding is configured via
      // the Pages dashboard.
      "binding": "DB",
      "database_name": "gallery-admin",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
