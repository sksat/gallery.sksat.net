{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gallery-admin",
  "compatibility_date": "2025-04-01",
  // With `pages_build_output_dir` set, Cloudflare Pages treats this file as
  // the source of truth for bindings and ignores the dashboard. Top-level
  // settings are the production deployment (and local dev); `env.preview`
  // overrides them for preview deployments.
  "pages_build_output_dir": "./dist",
  "vars": {
    // Cloudflare Access JWT verification (src/lib/access.ts). Not secrets:
    // the team domain is public and AUD tags only identify Access apps.
    // Production accepts only the custom-domain app (admin.gallery.sksat.net).
    "ACCESS_TEAM_DOMAIN": "https://sksat.cloudflareaccess.com",
    "ACCESS_AUD": "e5ff448257acbe43d36fecf57eb2a1e2f133d21c13c46315b5d61b08f332d93a",
    // "1" = thumbnails through /thumb/* and the IMAGES binding below. Empty
    // = placeholder tiles; the originals are never loaded. E2E blanks it on
    // the command line (e2e/start-test-server.sh) so VRT stays deterministic.
    "THUMBNAILS": "1",
  },
  // The image Worker's AdminImage entrypoint (workers/image): resized
  // thumbnails of any photo, private included, for the /thumb route. It
  // also verifies the request's Access JWT, which the route passes on.
  "services": [
    {
      "binding": "IMAGES",
      "service": "gallery-image",
      "entrypoint": "AdminImage",
    },
  ],
  "d1_databases": [
    {
      // Production D1 (`pnpm db.create`). A database id is an identifier,
      // not a credential: access still requires Cloudflare account auth.
      "binding": "DB",
      "database_name": "gallery-admin",
      "database_id": "70d6bc59-9937-48e0-90bb-0ef8a2a53bcd",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      // `vars` and `d1_databases` are not inherited by environments, so they
      // are restated here.
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://sksat.cloudflareaccess.com",
        // Preview deployments app (*.admin-gallery-sksat-net.pages.dev).
        "ACCESS_AUD": "eba20c113f589a0b3a11d2fd46268f17ead1732f1f5e01cbc6ef0da525d8ac8a",
        "THUMBNAILS": "1",
      },
      // Previews (incl. Renovate PRs) run unreviewed code, so they get no
      // database (the UI shows the missing-binding notice instead of being
      // able to read or rewrite production metadata) and no image Worker
      // binding (they could otherwise fetch any private photo by path):
      // thumbnails are placeholders there. The image Worker accepts only the
      // production Access app's tokens anyway.
      "services": [],
      "d1_databases": [],
    },
  },
}
